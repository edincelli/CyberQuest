  m_Name: 
  m_EditorClassIdentifier: 
  indicatorID: newgame_quest_ui
  indicatorPosition: 2
  indicatorText: The most important information for your current <b>quest</b> appears
    in the panel on the right.\n\nAll key details and objectives are displayed here.\n\nIn
    some quests, you will complete the task by selecting the correct option directly
    within this panel.
  indicatorArea: {x: 430, y: 1200}
