  m_EditorClassIdentifier: 
  indicatorID: newgame_globe_quest
  indicatorPosition: 0
  indicatorText: While exploring the globe, you will encounter <b>key points</b>
    marked on the map.\n\nThese markers highlight important locations, including
    <b>quests</b>, as well as other points of interest that may offer information,
    tools, or new opportunities.\n\nKeep an eye on them! They often play a crucial
    role in your progress.
  indicatorArea: {x: 150, y: 150}
