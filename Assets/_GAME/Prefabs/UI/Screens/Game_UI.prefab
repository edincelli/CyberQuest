  indicatorID: newgame_globe
  indicatorPosition: 0
  indicatorText: "<b>The globe</b> is the game\u2019s central hub.\\n\\nIt represents
    the world you will explore throughout <b>CyberQuest</b>.\\n\\nUse it to navigate
    to different locations, observe your surroundings, and uncover clues that may
    help you solve challenges and complete quests."
  indicatorArea: {x: 900, y: 900}
